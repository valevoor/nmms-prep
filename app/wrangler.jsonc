// Cloudflare Workers deploy: serves the built app (dist/) as static files.
// Build first (npm run build); `npx wrangler deploy` then uploads dist/.
{
  "name": "nmms-prep",
  "compatibility_date": "2026-10-01",
  // Runs only for paths that aren't files: app pages (/mat/number-series/learn) get app.html.
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
