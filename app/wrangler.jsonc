// Cloudflare Workers deploy: serves the built app (dist/) as static files.
// Build first (npm run build); `npx wrangler deploy` then uploads dist/.
{
  "name": "nmms-prep",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // App paths (/mat/number-series/learn) aren't files: answer them with index.html.
    "not_found_handling": "single-page-application"
  }
}
